# ===========================================
# XMOS - X Marketing Operating System
# Environment Configuration Template
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ===========================================

# -------------------------------------------
# Application Settings
# -------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Riyadh

# -------------------------------------------
# Database (SQLite)
# -------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/xmos.db

# -------------------------------------------
# X (Twitter) API Credentials
# -------------------------------------------
# Get these from https://developer.x.com/
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
X_BEARER_TOKEN=your_x_bearer_token
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret

# Callback URL for OAuth (update with your domain in production)
X_CALLBACK_URL=http://localhost:8000/api/x/callback

# -------------------------------------------
# DeepSeek AI API
# -------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# -------------------------------------------
# Content Limits & Budget Guards
# -------------------------------------------
MAX_AI_POSTS_PER_DAY=5
MAX_AI_THREADS_PER_DAY=2
MAX_TREND_SCANS_PER_DAY=3
MAX_WATCHLIST_ACCOUNTS=10
MAX_MONTHLY_AI_BUDGET=100.0
MAX_MONTHLY_X_API_BUDGET=100.0

# -------------------------------------------
# Security
# -------------------------------------------
SECRET_KEY=your-secret-key-for-sessions-and-tokens-generate-a-random-string
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=change-this-password-immediately

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=data/xmos.log

# -------------------------------------------
# Backup Settings
# -------------------------------------------
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=30
